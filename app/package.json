{
    "name": "pokesleep-ast",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "extract-data": "node scripts/extract-data.mjs",
        "sprites": "node scripts/fetch-sprites.mjs",
        "cap:sync": "npm run build && npx cap sync",
        "build:android": "node scripts/build-app.mjs android debug",
        "build:android:debug": "node scripts/build-app.mjs android debug",
        "build:android:prod": "node scripts/build-app.mjs android prod",
        "build:ios": "node scripts/build-app.mjs ios debug",
        "build:ios:debug": "node scripts/build-app.mjs ios debug",
        "build:ios:prod": "node scripts/build-app.mjs ios prod",
        "build:app": "node scripts/build-app.mjs all debug",
        "build:app:debug": "node scripts/build-app.mjs all debug",
        "build:app:prod": "node scripts/build-app.mjs all prod"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.2",
        "@capacitor/core": "^8.5.2",
        "@capacitor/filesystem": "^8.1.4",
        "@capacitor/ios": "^8.5.2",
        "@capacitor/preferences": "^8.0.1",
        "@capacitor/share": "^8.0.3",
        "onnxruntime-web": "^1.30.0",
        "pinia": "^4.0.3",
        "vue": "^3.5.42",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.5.2",
        "@types/node": "^24.13.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/tsconfig": "^0.9.1",
        "typescript": "~6.0.2",
        "vite": "^8.3.0",
        "vitest": "^5.0.3",
        "vue-tsc": "^3.3.11"
    }
}
